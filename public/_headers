# Response headers for Cloudflare static assets (https://developers.cloudflare.com/workers/static-assets/headers/)
# Cloudflare reads this file; it is not served.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Astro's build output: every file name carries a content hash, so it can be cached forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
