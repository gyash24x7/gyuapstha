// Cloudflare Workers config: serves the static Astro build (dist/) as static assets, no Worker code.
// Deploy with `bun run deploy`, or connect the repo in the Cloudflare dashboard (Workers Builds).
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "yashgupta",
	"compatibility_date": "2026-09-23",
	"assets": {
		"directory": "./dist",
		// Unknown paths get dist/404.html with a 404 status
		"not_found_handling": "404-page",
		// /contact and /contact/ resolve to the same page; links in the site never use trailing slashes
		"html_handling": "auto-trailing-slash"
	}
}
