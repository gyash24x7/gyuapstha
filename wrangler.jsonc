// Cloudflare Workers config: serves the static Astro build (dist/) as static assets, no Worker code.
// Deploy with `bun run deploy`, or connect the repo's v1 branch in the Cloudflare dashboard (Workers Builds).
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "yashgupta-v1",
	"compatibility_date": "2026-09-23",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash"
	}
}
