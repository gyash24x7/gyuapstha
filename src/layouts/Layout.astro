---
import { Font } from "astro:assets";
import Particles from "../components/Particles.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Yash Gupta | Developer",
	description = "Yash Gupta is a full-stack developer from Kanpur, India, building websites, apps and everything in between."
} = Astro.props;
---

<html lang="en">
<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="description" content={ description }/>
	<meta name="generator" content={ Astro.generator }/>
	<meta name="theme-color" content="#fca311"/>
	<link rel="icon" href="/favicon.ico" sizes="32x32"/>
	<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
	<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
	<title>{ title }</title>
	<Font cssVariable="--font-display" preload/>
	<Font cssVariable="--font-body" preload/>
	<Font cssVariable="--font-mono"/>
	<script is:inline>
		// Lets CSS reserve space for script-driven features (like the toolbox graph) before they load
		document.documentElement.classList.add( "js" );
		// Apply the saved theme before first paint to avoid a flash of the wrong theme
		try {
			const theme = localStorage.getItem( "theme" );
			if ( theme === "light" || theme === "dark" ) {
				document.documentElement.dataset.theme = theme;
			}
		} catch {}
	</script>
</head>
<body>
<Particles/>
<slot/>
</body>
</html>
