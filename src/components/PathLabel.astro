---
interface Props {
	path: string;
	base?: string;
}

const { path, base = "~/" } = Astro.props;
---

<p class="path">{ base }<b>{ path }</b></p>

<style>
	.path {
		font: 500 13px/1.4 var(--font-mono);
		letter-spacing: .06em;
		color: var(--ink-muted);
	}

	.path::before {
		content: "\276F  ";
		color: var(--accent-ink);
	}

	b {
		font-weight: 500;
		color: var(--ink);
	}
</style>
