---
import Chip from "./Chip.astro";
import InlineLink from "./InlineLink.astro";

interface Props {
	/** Two-letter corner index, e.g. "HN" */
	index: string;
	title: string;
	description: string;
	tech?: string[];
	links?: { label: string; href: string }[];
	pip?: "marigold" | "chilli" | "peacock";
	/** Resting tilt in degrees, -2 to 2 */
	tilt?: number;
}

const { index, title, description, tech = [], links = [], pip = "marigold", tilt = 0 } = Astro.props;
---

<article class="card" style={ `--pip: var(--${ pip }); --tilt: ${ tilt }deg` }>
	<span class="index" aria-hidden="true"><i></i>{ index }</span>
	<h3>{ title }</h3>
	<p>{ description }</p>
	{ tech.length > 0 && (
		<div class="chips">
			{ tech.map( item => <Chip>{ item }</Chip> ) }
		</div>
	) }
	{ links.length > 0 && (
		<div class="links">
			{ links.map( ( { label, href } ) => <InlineLink href={ href }>{ label }</InlineLink> ) }
		</div>
	) }
	<span class="index index--flipped" aria-hidden="true"><i></i>{ index }</span>
</article>

<style>
	.card {
		--lift: var(--sticker-md);
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		max-width: 340px;
		padding: var(--space-8) var(--space-6) var(--space-6);
		color: var(--ink);
		background: var(--paper-raised);
		border: var(--border-sticker) solid var(--ink);
		border-radius: var(--radius-md);
		box-shadow: var(--lift);
		transform: rotate(var(--tilt));
		transition: transform var(--duration-base) var(--ease-spring), box-shadow var(--duration-base) var(--ease-spring);
	}

	.card:hover {
		--lift: var(--sticker-lg);
		transform: translate(-2px, -3px) rotate(calc(var(--tilt) - 1deg));
	}

	.index {
		position: absolute;
		top: var(--space-3);
		left: var(--space-4);
		display: flex;
		align-items: center;
		gap: var(--space-1);
		font: 500 12px/1 var(--font-mono);
		letter-spacing: .06em;
		color: var(--ink-muted);
	}

	.index i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--pip);
		border: 1.5px solid var(--ink);
	}

	.index--flipped {
		top: auto;
		left: auto;
		bottom: var(--space-3);
		right: var(--space-4);
		transform: rotate(180deg);
	}

	h3 {
		font: 700 28px/1.2 var(--font-display);
		letter-spacing: -.01em;
	}

	p {
		font: 400 14px/1.55 var(--font-body);
		color: var(--ink-muted);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		padding-bottom: var(--space-4);
		font-size: 14px;
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}

		.card:hover {
			transform: rotate(var(--tilt));
		}
	}
</style>
