---
import { email, resume, socials } from "../data/contact";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import PathLabel from "./PathLabel.astro";

// Let a long address wrap after the @ rather than mid-word
const [ user, domain ] = email.split( "@" );
---

<section id="contact" class="container section" aria-labelledby="contact-title">
	<div class="intro">
		<PathLabel path="contact"/>
		<h2 id="contact-title" class="display-l">Let's <span class="highlight">talk</span>.</h2>
		<p class="body-l lede">
			Want to talk about a project, an idea, or a Literature hand you can't figure out? My inbox is open.
		</p>

		<div class="links">
			<Button variant="secondary" href={ resume.href } download={ resume.filename }>
				<Icon name="download"/>
				Download résumé
			</Button>
			<ul class="socials">
				{ socials.map( social => (
					<li>
						<a class="social" href={ social.href } aria-label={ `${ social.label }, ${ social.handle }` } title={ social.label }>
							<Icon name={ social.icon } size={ 22 }/>
						</a>
					</li>
				) ) }
			</ul>
		</div>
	</div>

	<div class="card" data-copy-email>
		<span class="label muted">email</span>
		<p class="address" data-email>{ user }@<wbr/>{ domain }</p>
		<div class="actions">
			<Button href={ `mailto:${ email }` }>Email me</Button>
			<Button variant="secondary" data-copy>Copy address</Button>
			<span class="label status" data-status role="status" aria-live="polite"></span>
		</div>
	</div>
</section>

<style>
	.section {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		gap: var(--space-8);
		padding-block: var(--section-gap);
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.lede {
		max-width: 46ch;
		color: var(--ink-muted);
	}

	/* One sticker: the address is the thing to pick up */
	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		width: fit-content;
		max-width: 100%;
		padding: var(--space-6);
		background: var(--paper-raised);
		border: var(--border-sticker) solid var(--ink);
		border-radius: var(--radius-md);
		box-shadow: var(--sticker-md);
		transform: rotate(-1deg);
	}

	.address {
		font: 700 clamp(19px, 5vw, 36px)/1.2 var(--font-display);
		letter-spacing: -.01em;
		user-select: all;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
		margin-top: var(--space-2);
	}

	.status {
		color: var(--peacock);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
		margin-top: var(--space-4);
	}

	.socials {
		display: flex;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Round stickers for the social marks */
	.social {
		--lift: var(--sticker-sm);
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		color: var(--ink);
		background: var(--paper-raised);
		border: var(--border-sticker) solid var(--ink);
		border-radius: 50%;
		box-shadow: var(--lift);
		transition: transform var(--duration-quick) var(--ease-spring), box-shadow var(--duration-quick) var(--ease-spring), color var(--duration-quick) ease-out;
	}

	.social:hover {
		--lift: var(--sticker-md);
		color: var(--accent-ink);
		transform: translate(-2px, -2px) rotate(-6deg);
	}

	.social:active {
		--lift: none;
		transform: translate(3px, 3px);
	}

	@media (min-width: 900px) {
		.section {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: var(--space-12);
		}

		.card {
			padding: var(--space-8);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.social:hover,
		.social:active {
			transform: none;
		}

		.social {
			transition: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>( "[data-copy-email]" ).forEach( card => {
		const button = card.querySelector<HTMLButtonElement>( "[data-copy]" )!;
		const address = card.querySelector<HTMLElement>( "[data-email]" )!;
		const status = card.querySelector<HTMLElement>( "[data-status]" )!;
		let timer = 0;

		const say = ( message: string ) => {
			status.textContent = message;
			clearTimeout( timer );
			timer = window.setTimeout( () => status.textContent = "", 2500 );
		};

		button.addEventListener( "click", async () => {
			try {
				await navigator.clipboard.writeText( address.textContent?.trim() ?? "" );
				say( "Copied" );
			} catch {
				// Clipboard blocked: select the address so it can be copied by hand
				window.getSelection()?.selectAllChildren( address );
				say( "Press Ctrl+C or ⌘C to copy" );
			}
		} );
	} );
</script>
