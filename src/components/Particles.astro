<canvas class="particles" data-particles aria-hidden="true"></canvas>

<style>
	.particles {
		position: fixed;
		z-index: -1;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
</style>

<script>
	import { mountParticles } from "../scripts/particles";

	const canvas = document.querySelector<HTMLCanvasElement>( "[data-particles]" );
	if ( canvas ) {
		mountParticles( canvas );
	}
</script>
