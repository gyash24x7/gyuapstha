---
import Button from "../components/Button.astro";
import Chip from "../components/Chip.astro";
import InlineLink from "../components/InlineLink.astro";
import PathLabel from "../components/PathLabel.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Layout from "../layouts/Layout.astro";

const colors = [
	"paper", "paper-raised", "ink", "ink-muted", "line-soft", "marigold", "marigold-soft",
	"accent-ink", "chilli", "peacock"
];
const typeStyles = [
	[ "display-xl", "Hi, I'm Yash." ],
	[ "display-l", "Things I've built" ],
	[ "heading-1", "Software Engineer II" ],
	[ "heading-2", "Honeywell" ],
	[ "heading-3", "Warehouse Execution System" ],
	[ "body-l", "An IIT Madras graduate based in Kanpur, India, building websites, apps and everything in between." ],
	[ "body", "Developed microservices in Java with Spring Boot, RabbitMQ, Postgres and Kafka." ],
	[ "small", "August 2020 – present" ],
	[ "label", "~/projects" ],
	[ "code", "git log --oneline" ]
];
---

<Layout title="Style guide | Yash Gupta">
	<main class="container page">
		<header class="top">
			<div>
				<PathLabel path="styleguide"/>
				<h1 class="display-l">Style guide</h1>
			</div>
			<ThemeToggle/>
		</header>

		<section>
			<PathLabel path="colour" base="~/styleguide/"/>
			<ul class="swatches">
				{ colors.map( name => (
					<li>
						<span class="swatch" style={ `background: var(--${ name })` }></span>
						<span class="label">{ name }</span>
					</li>
				) ) }
			</ul>
		</section>

		<section>
			<PathLabel path="type" base="~/styleguide/"/>
			<div class="type">
				{ typeStyles.map( ( [ name, sample ] ) => (
					<div class="type-row">
						<span class="label muted">{ name }</span>
						<p class={ name }>{ sample }</p>
					</div>
				) ) }
			</div>
			<p class="heading-1">I build things for the <span class="highlight">web</span>.</p>
		</section>

		<section>
			<PathLabel path="components" base="~/styleguide/"/>
			<div class="row">
				<Button href="mailto:contact@yashgupta.dev">Email me</Button>
				<Button variant="secondary">Download résumé</Button>
				<Button variant="ghost" href="https://github.com/gyash24x7">Read the code →</Button>
			</div>
			<div class="row">
				<Chip>React</Chip>
				<Chip>NestJS</Chip>
				<Chip>GraphQL</Chip>
				<Chip variant="hot">currently</Chip>
				<Chip variant="live">live</Chip>
			</div>
			<p class="body prose">
				At <InlineLink href="https://honeywell.com">Honeywell</InlineLink> I build microservices for a warehouse
				execution system. Before that I helped <InlineLink href="https://hakimo.ai">Hakimo</InlineLink> stream
				live camera feeds to the cloud.
			</p>
			<div class="row cards">
				<ProjectCard
					index="HN"
					title="Hacknotes"
					description="A light, cross-platform app to jot down ideas and tasks. Syncs across Android, iOS and the web."
					tech={ [ "React Native", "React", "NestJS" ] }
					links={ [
						{ label: "Code", href: "https://github.com/gyash24x7/hacknotes" },
						{ label: "Web app", href: "https://hacknotes.yashgupta.dev" }
					] }
					tilt={ -1 }
				/>
				<ProjectCard
					index="LT"
					title="Literature"
					description="Canadian Fish, the six-player card game played in teams of three, online."
					tech={ [ "Ionic", "React", "GraphQL", "NestJS" ] }
					links={ [
						{ label: "Code", href: "https://github.com/gyash24x7/littplay" },
						{ label: "Play it", href: "https://literature.yashgupta.dev" }
					] }
					pip="chilli"
					tilt={ 1.5 }
				/>
			</div>
		</section>
	</main>
</Layout>

<style>
	.page {
		display: flex;
		flex-direction: column;
		gap: var(--section-gap);
		padding-block: var(--space-12);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.top {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.swatches {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
		gap: var(--space-4);
		padding: 0;
		list-style: none;
	}

	.swatches li {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.swatch {
		height: 72px;
		border: var(--border-sticker) solid var(--ink);
		border-radius: var(--radius-sm);
	}

	.type {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.type-row {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		align-items: baseline;
		gap: var(--space-4);
		padding-bottom: var(--space-4);
		border-bottom: var(--border-hair) solid var(--line-soft);
	}

	.row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
	}

	.cards {
		align-items: flex-start;
		gap: var(--space-8);
	}

	.prose {
		max-width: var(--text-max);
	}

	@media (max-width: 600px) {
		.type-row {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-1);
		}
	}
</style>
