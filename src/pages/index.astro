---
import PathLabel from "../components/PathLabel.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<main class="container hero">
		<PathLabel path="home"/>
		<h1 class="display-xl">Hi, I'm <span class="highlight">Yash</span>.</h1>
		<p class="body-l muted">I build things for the web. And for mobile as well.</p>
	</main>
</Layout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-block: var(--space-24);
	}
</style>
