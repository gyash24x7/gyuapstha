---
import Button from "../components/Button.astro";
import Chip from "../components/Chip.astro";
import PathLabel from "../components/PathLabel.astro";
import Portrait from "../components/Portrait.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Layout from "../layouts/Layout.astro";

const toolbox = [
	"React", "Node.js", "NestJS", "Next.js", "GraphQL", "Apollo", "React Native", "Expo", "Ionic",
	"TypeScript", "Java", "Spring Boot", "Kafka", "RabbitMQ", "Kubernetes", "Docker", "PostgreSQL", "MongoDB"
];
---

<Layout>
	<header class="container header">
		<a class="wordmark" href="/" aria-label="Yash Gupta, home">yg<span>.</span></a>
		<ThemeToggle/>
	</header>

	<main>
		<section class="container hero" aria-labelledby="hero-title">
			<div class="intro">
				<PathLabel path="home"/>
				<h1 id="hero-title" class="display-xl">Hi, I'm <span class="highlight">Yash</span>.</h1>
				<p class="body-l lede">
					I'm a full-stack developer from Kanpur, India, and an IIT Madras graduate. I build websites, apps
					and everything in between.
				</p>
				<div class="actions">
					<Button href="mailto:contact@yashgupta.dev">Email me</Button>
					<Button variant="ghost" href="https://github.com/gyash24x7">GitHub →</Button>
				</div>
			</div>
			<div class="art">
				<Portrait/>
				<p class="label muted hint" aria-hidden="true">psst, click me</p>
			</div>
			<a class="scroll-cue label" href="#toolbox">scroll <span aria-hidden="true">↓</span></a>
		</section>

		<section id="toolbox" class="container section" aria-labelledby="toolbox-title">
			<PathLabel path="toolbox"/>
			<h2 id="toolbox-title" class="heading-1">Things I reach for</h2>
			<ul class="chips">
				{ toolbox.map( tool => <li><Chip>{ tool }</Chip></li> ) }
			</ul>
		</section>
	</main>
</Layout>

<style>
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: var(--space-6);
	}

	.wordmark {
		font: 800 28px/1 var(--font-display);
		letter-spacing: -.03em;
		text-decoration: none;
	}

	.wordmark span {
		color: var(--accent-ink);
	}

	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		gap: var(--space-8);
		min-height: calc(100svh - 80px);
		padding-block: var(--space-8) var(--space-16);
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		order: 2;
	}

	.lede {
		max-width: 34ch;
		color: var(--ink-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
		margin-top: var(--space-4);
	}

	.art {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-3);
		order: 1;
		width: min(100%, 340px);
		margin-inline: auto;
	}

	.hint {
		transform: rotate(-3deg);
	}

	.scroll-cue {
		position: absolute;
		left: 50%;
		bottom: var(--space-4);
		display: none;
		gap: var(--space-2);
		color: var(--ink-muted);
		text-decoration: none;
		letter-spacing: .3em;
		transform: translateX(-50%);
	}

	.scroll-cue span {
		display: inline-block;
		color: var(--accent-ink);
		animation: nudge 1.6s var(--ease-smooth) infinite;
	}

	@keyframes nudge {
		50% {
			transform: translateY(4px);
		}
	}

	.section {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-block: var(--section-gap);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		max-width: 760px;
		margin-top: var(--space-4);
		padding: 0;
		list-style: none;
	}

	@media (min-width: 900px) {
		.hero {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			gap: var(--space-12);
		}

		.intro,
		.art {
			order: 0;
		}

		.art {
			width: 100%;
		}

		.scroll-cue {
			display: inline-flex;
		}
	}
</style>
